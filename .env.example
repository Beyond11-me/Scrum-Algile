# Local Docker development only. Use URL-safe letters and digits in this value.
# It must satisfy SQL Server's SA password complexity requirements.
MSSQL_SA_PASSWORD=LocalDevSql123456
SECRET_KEY=local-development-only-change-this-secret-key
GEMINI_API_KEY=
Email__Provider=GmailSmtp
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__Security=StartTls
Email__Username=your-email@example.com
Email__AppPassword=your-app-password
Email__FromAddress=your-email@example.com
Email__FromName=iSQL
